# Vista pública: no necesitas crear .env.local.
# Para probar cuentas y rutinas, usa un proyecto Supabase de pruebas.
# Copia este archivo como .env.local y completa SOLO los valores públicos:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dirección pública de la web, sin barra final (imagen para compartir y sitemap).
# En local puede quedar vacía.
NEXT_PUBLIC_SITE_URL=
